APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=11000

TRANSCRIBING_DRIVER=parakeet
TRANSCRIBING_LANGUAGE=ro
TRANSCRIBING_DEVICE=cpu
# auto = float16 on CUDA, int8 on CPU for faster-whisper
TRANSCRIBING_COMPUTE_TYPE=auto
# SpeakerID is optional on the CPU server. Accept the pyannote model terms on
# Hugging Face and place the token only in the untracked .env before enabling it.
TRANSCRIBING_DIARIZATION_ENABLED=false
TRANSCRIBING_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=

# Generate a strong random value in the untracked .env before enabling the worker API.
WORKER_API_TOKEN=
WORKER_API_AUTH_ATTEMPTS_PER_MINUTE=20
WORKER_API_AUTH_ATTEMPTS_PER_CREDENTIAL_PER_MINUTE=10
WORKER_API_THROTTLE_PER_MINUTE=60
# Server-side transcription through the worker API requires QUEUE_CONNECTION=database
# with after_commit=false and DB_QUEUE_CONNECTION unset or equal to DB_CONNECTION.
# PHP upload_max_filesize/post_max_size and the fronting server body limit must
# exceed the largest WORKER_*_MAX_BYTES value; application validation runs later.
WORKER_FFPROBE_PATH=ffprobe
WORKER_FFPROBE_TIMEOUT=15
WORKER_VIDEO_MAX_BYTES=5368709120
WORKER_AUDIO_MAX_BYTES=1073741824
WORKER_TRANSCRIPT_MAX_BYTES=52428800
WORKER_TRANSCRIPT_MAX_SEGMENTS=100000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
