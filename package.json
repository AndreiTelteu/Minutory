{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "test:frontend": "node --experimental-strip-types tests/frontend/meetingFilename.test.ts && TZ=Europe/Bucharest node --experimental-strip-types tests/frontend/bucharestDateTime.test.ts && TZ=Europe/Bucharest node --experimental-strip-types tests/frontend/browserDateTimeTimezone.test.ts Europe/Bucharest \"Jul 10, 2026, 1:03:47 PM\" && TZ=America/Los_Angeles node --experimental-strip-types tests/frontend/browserDateTimeTimezone.test.ts America/Los_Angeles \"Jul 10, 2026, 3:03:47 AM\"",
        "typecheck": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@types/node": "^25.3.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^10.8.0",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript-eslint": "^8.23.0",
        "vue-tsc": "^3.2.5"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.19.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "^1.54.2",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.2.2",
        "vite": "^7.0.4",
        "vue": "^3.5.13",
        "ziggy-js": "^2.4.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
