MINUTORY_API_BASE_URL=http://localhost:8000
MINUTORY_API_TOKEN=[REDACTED]
# Optional: HTTP Basic Auth. Set username and password together.
MINUTORY_API_BASIC_AUTH_USERNAME=
MINUTORY_API_BASIC_AUTH_PASSWORD=[REDACTED]
# Optional: arbitrary header applied to every Worker API request. Set key and value together.
MINUTORY_API_CUSTOM_HEADER_KEY=
MINUTORY_API_CUSTOM_HEADER_VALUE=[REDACTED]
MINUTORY_TIMEZONE=Europe/Bucharest
MINUTORY_FFMPEG_PATH=./libs/ffmpeg/bin/ffmpeg.exe
MINUTORY_FFPROBE_PATH=./libs/ffmpeg/bin/ffprobe.exe
MINUTORY_MODEL_DIR=./models
MINUTORY_RUNTIME_DIR=./libs
MINUTORY_WORK_DIR=./work
MINUTORY_STATE_DB=./state/worker.sqlite3
MINUTORY_CONNECT_TIMEOUT=10
MINUTORY_READ_TIMEOUT=120
MINUTORY_UPLOAD_TIMEOUT=3600
MINUTORY_COMPRESSION_PRESET=balanced
MINUTORY_VIDEO_CODEC=h264_amf
MINUTORY_FALLBACK_VIDEO_CODEC=libx264
MINUTORY_WHISPER_MODEL=large-v3
MINUTORY_LANGUAGE=ro
MINUTORY_VAD_FILTER=true
MINUTORY_VAD_MIN_SILENCE_MS=500
# pyannote SpeakerID runs on CPU. Keep this at the number of physical cores
# (16 on the Ryzen 9 7950X3D); lower it if desktop responsiveness matters.
MINUTORY_SPEAKERID_THREADS=16
# Accept the pyannote model terms on Hugging Face, then set this only while
# running resolve-assets.ps1. The resolver downloads the gated snapshot locally;
# bootstrap and the worker always run offline and never receive this token.
MINUTORY_DIARIZATION_TOKEN=[REDACTED]
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
